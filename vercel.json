{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/movimento",
      "destination": "/movimentoblackmoney",
      "permanent": true
    },
    {
      "source": "/movimento.html",
      "destination": "/movimentoblackmoney",
      "permanent": true
    },
    {
      "source": "/cases/petrobras",
      "destination": "/case-petrobras",
      "permanent": true
    },
    {
      "source": "/cases/petrobras.html",
      "destination": "/case-petrobras",
      "permanent": true
    }
  ]
}